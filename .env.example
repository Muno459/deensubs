# R2 S3 API credentials for uploading media via `aws s3 cp`.
# Copy this file to `.env` (which is gitignored) and fill in the real values.
# Load into your shell with:  set -a; source .env; set +a
export AWS_ACCESS_KEY_ID=your_r2_access_key_id
export AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key
export R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
